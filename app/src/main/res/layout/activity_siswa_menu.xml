<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/dashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Siswa"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#5695e1"
            android:textColor="#fff"
            android:textSize="24sp"
            android:paddingVertical="16dp"
            android:paddingHorizontal="12dp" />

        <!-- Tanggal -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/currentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19 Juli 2025"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Menu Grid -->
        <GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <!-- Tambah Siswa -->
            <Button
                android:id="@+id/btnTambahSiswa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_columnWeight="1"
                android:drawableTop="@drawable/floppy"
                android:drawablePadding="12dp"
                android:drawableTint="@color/white"
                android:text="Tambah Siswa"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="#1ba656"
                android:padding="12dp" />

            <!-- Daftar Siswa -->
            <Button
                android:id="@+id/btnDaftarSiswa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_columnWeight="1"
                android:drawableTop="@drawable/list"
                android:drawablePadding="12dp"
                android:text="Daftar Siswa"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="#1ba656"
                android:padding="12dp" />

            <!-- Cetak Kartu -->
            <Button
                android:id="@+id/btnGenerateQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_columnWeight="1"
                android:drawableTop="@drawable/qr"
                android:drawablePadding="12dp"
                android:text="Cetak Kartu"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="#725dd8"
                android:padding="12dp" />

            <!-- Unduh Data -->
            <Button
                android:id="@+id/btnExportAbsen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_columnWeight="1"
                android:drawableTop="@drawable/download_24"
                android:drawablePadding="12dp"
                android:text="Unduh Data"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="@color/lightBlue"
                android:padding="12dp" />

            <!-- Hapus Siswa -->
            <Button
                android:id="@+id/btnDeleteSiswa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_columnWeight="1"
                android:drawableTop="@drawable/person_remove"
                android:drawablePadding="12dp"
                android:text="Hapus Siswa"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="@color/red"
                android:padding="12dp" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
