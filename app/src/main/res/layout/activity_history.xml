<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lightBlue"
        android:gravity="center"
        android:text="Monitoring Presensi"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pencarian -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/searchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/cari"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/searchEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan nama"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kelasLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="kelas"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/kelasSpin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabel dengan scroll -->
    <HorizontalScrollView
        android:id="@+id/tableScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:scrollbars="horizontal"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintBottom_toTopOf="@id/paginationContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <TableLayout
                android:id="@+id/tableAbsensi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/gray"
                android:stretchColumns="*">

                <TableRow>
                    <TextView
                        android:id="@+id/headerNo"
                        style="@style/TableHeaderStyle"
                        android:text="@string/no" />

                    <TextView
                        android:id="@+id/headerNisn"
                        style="@style/TableHeaderStyle"
                        android:text="@string/nama" />

                    <TextView
                        android:id="@+id/headerKet"
                        style="@style/TableHeaderStyle"
                        android:text="@string/ket" />

                    <TextView
                        android:id="@+id/headerTanggal"
                        style="@style/TableHeaderStyle"
                        android:text="@string/tanggal" />

                    <TextView
                        android:id="@+id/headerJamasuk"
                        style="@style/TableHeaderStyle"
                        android:text="@string/datang" />

                    <TextView
                        android:id="@+id/headerJampulang"
                        style="@style/TableHeaderStyle"
                        android:text="@string/pulang" />
                </TableRow>
            </TableLayout>
        </ScrollView>
    </HorizontalScrollView>

    <!-- Pagination -->
    <!-- Pagination -->
    <LinearLayout
        android:id="@+id/paginationContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/pageInfoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/prevpage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_trans_btn"
            android:backgroundTint="@color/lightBlue"
            android:padding="8dp"
            android:text="&lt;"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginEnd="36dp" />

        <Button
            android:id="@+id/nextpage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_trans_btn"
            android:backgroundTint="@color/lightBlue"
            android:padding="8dp"
            android:text="&gt;"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/pageInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pageinfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/halaman"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
