<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/lightBlue"
        android:gravity="center"
        android:padding="12dp"
        android:text="SMK Gelora Industri Bekasi"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="Dashboard Admin"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/subTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Tahun Ajaran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="@color/lightBlue"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tahun Ajaran Aktif:"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tahunAjar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025/2026"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kehadiran Hari Ini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_trans_btn"
                android:backgroundTint="@color/lightBlue"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kehadiran Hari Ini (19/08/2025)"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <TextView android:text="✅ Hadir: 286"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView android:text="🤒 Sakit: 12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView android:text="🙏 Izin: 9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView android:text="❌ Alfa: 8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Menu -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="space_between">

                <Button
                    android:id="@+id/btnInputData"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    app:layout_flexBasisPercent="45%"
                    android:layout_margin="6dp"
                    android:background="@drawable/rounded_trans_btn"
                    android:backgroundTint="@color/lightBlue"
                    android:text="Input Data"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnRekapAbsensi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    app:layout_flexBasisPercent="45%"
                    android:layout_margin="6dp"
                    android:background="@drawable/rounded_trans_btn"
                    android:backgroundTint="@color/lightBlue"
                    android:text="Rekap Presensi"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnLaporanAbsensi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    app:layout_flexBasisPercent="45%"
                    android:layout_margin="6dp"
                    android:background="@drawable/rounded_trans_btn"
                    android:backgroundTint="@color/lightBlue"
                    android:text="Laporan Presensi"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnPengaturan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    app:layout_flexBasisPercent="45%"
                    android:layout_margin="6dp"
                    android:background="@drawable/rounded_trans_btn"
                    android:backgroundTint="@color/lightBlue"
                    android:text="Pengaturan"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"/>
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
